# 环境变量（含敏感 token，绝不提交）
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
.venv/
venv/

# DuckDB 数据文件
data/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 测试 & 覆盖率
.pytest_cache/
htmlcov/
.coverage

# 类型/lint 缓存
.mypy_cache/
.ruff_cache/

# 误产生的 :memory: 文件（DuckDB 误把 :memory: 当文件名）
\:memory:

# 工具记忆文件（非项目代码）
.codebuddy/

# uv
.python-version

# OS
.DS_Store
Thumbs.db

# 日志
*.log

# 前端（web/）— 当前未启用，保留占位目录
# 未来启用时解除下面的注释，并把 web/.gitkeep 删掉
# web/node_modules/
# web/dist/
# web/.vite/
# web/web/

# 临时截图/图片（参考用，不入库）
*.png
*.jpg
*.jpeg
*.gif
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.gif

# 同花顺登录缓存（含登录凭证，绝不入库）
scripts/ths_*.json
scripts/.ths_*

# 实际配置文件（含个人配置，不入库；保留 .example 入库）
config.yaml

# 外部引入的独立仓库（非本项目代码）
extra/

# watchlist（含个人自选股，不提交）
watchlist.yaml
