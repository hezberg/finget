# finget 环境变量配置
# 复制为 .env 并填入实际值：
#   cp .env.example .env
#
# 必填：
#   TUSHARE_TOKEN=your_token_here
#
# 可选（默认值已够用，无需修改）：
#   TUSHARE_MIRROR_URLS=https://fast.xiaodefa.cn,https://tt.xiaodefa.cn
#   FINGET_LOG_LEVEL=INFO

# =============================================================================
# 必填：tushare API token
# 获取方式：https://tushare.pro 注册后查看个人主页
# =============================================================================
TUSHARE_TOKEN=your_tushare_token_here

# =============================================================================
# 可选：tushare 镜像站地址（逗号分隔，初始化时自动测速选最快的）
# 优先 HTTPS；如果 SSL 报错会自动降级 HTTP 重试
# 留空则使用内置默认（fast.xiaodefa.cn, tt.xiaodefa.cn）
# =============================================================================
# TUSHARE_MIRROR_URLS=https://fast.xiaodefa.cn,https://tt.xiaodefa.cn

# =============================================================================
# 可选：日志级别
# TRACE / DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
# 默认 INFO
# =============================================================================
# FINGET_LOG_LEVEL=INFO

# =============================================================================
# 可选：策略配置文件路径
# 控制 `finget fetch latest` 和 `finget scan` 的行为
# 不设置则查找项目根目录下的 config.yaml
# 文件不存在时使用内置默认值
# 参考 config.yaml.example
# =============================================================================
# FINGET_CONFIG_FILE=/path/to/config.yaml

# =============================================================================
# 可选：同花顺自选股账号（用于 watchlist 同步）
# finget watchlist sync 命令用它登录同花顺，拉取自选股分组生成 watchlist.yaml
# 不填则 watchlist sync 不可用（不影响其他命令）
# =============================================================================
# THS_USERNAME=your_ths_account
# THS_PASSWORD=your_ths_password
